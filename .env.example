# Supabase is optional for local Phase 7 demos. Leave these blank or replace
# every placeholder with real project values to enable Supabase catalog reads.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Not used for Phase 7 public catalog reads.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

OPENAI_API_KEY=your-openai-api-key
